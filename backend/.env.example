# Which model provider to use: gemini (default) or ollama
LLM_PROVIDER=gemini

# --- Gemini (free key: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# --- Ollama (fully local: `ollama pull llama3.2`; needs a model with tool calling) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2

# --- Database ---
# Leave empty to use SQLite in backend/data/. With docker compose:
# DATABASE_URL=postgresql+psycopg://analyst:analyst@localhost:5433/incidents
DATABASE_URL=

# Frontend origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173
